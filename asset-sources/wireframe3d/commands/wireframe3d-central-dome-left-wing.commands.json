  "commands": [
    {
      "op": "create_scene",
      "overrides": {
        "meta": {
          "name": "central-dome-left-wing-wireframe",
          "units": "meters",
          "sourceReferences": [
            "data/blueprint_campus_central_complex.jpg",
            "data/booklet-page3.png",
            "https://monolithicdome.com/captain-america-shield-covers-mit-great-dome/fig/04-mit-great-dome-night-shot-justin-jensen",
            "https://images.fineartamerica.com/images-medium-large-5/mit-building-10-the-great-dome-marianne-campolongo.jpg",
            "https://media.istockphoto.com/id/2169522150/fi/valokuva/massachusetts-institute-of-technologyn-etun%C3%A4kym%C3%A4-kes%C3%A4ll%C3%A4.jpg?s=2048x2048&w=is&k=20&c=gUhWDni0LjDiDG9AQeUnyXj0WyYZfjwTVtIMxA0V5ao="
          ],
          "mapPrototype2Reference": {
            "domeTile": "H6",
            "wingRooms": [
              "F7 Aero Lobby",
              "F5 Engineering Building"
            ],
            "interpretation": "Left wing is the smaller Aero/Engineering side around column F, west of the H6 dome core.",
            "modelScaleNote": "Wing model length is intentionally architectural rather than tile-count literal: each wing runs 18.6m north-south, matching the central core width so the Central Complex reads as a square campus block."
          },
          "attachmentContract": {
            "shoulderSource": "wireframe3d-central-dome-core.commands.json",
            "shoulderRef": {
              "id": "left_shoulder_ref",
              "center": [
                -7.3,
                2.25,
                -0.33
              ],
              "size": {
                "width": 4,
                "height": 3.7,
                "depth": 5.7
              },
              "westEdge": -9.3,
              "frontZ": 2.52,
              "rearZ": -3.18
            },
            "wing": {
              "id": "left_wing_mass",
              "center": [
                -11.125,
                1.9,
                -3.4
              ],
              "size": {
                "width": 3.65,
                "height": 3.05,
                "depth": 18.6
              },
              "attachesTo": "left_shoulder_ref west side",
              "eastEdge": -9.3,
              "frontZ": 5.9,
              "rearZ": -12.7
            }
          },
          "designIntent": "Separate left wing for the Central Complex. The wing is intentionally lengthened to match the 18.6m central core width, so the west-side Aero/Engineering range reads as one long side of the square Central Complex rather than a small appendage beside the shoulder.",
          "photoInterpretation": {
            "courtyardPhoto": "Snowy plaza view of the left wing: quiet two-story classical facade, repeated tall lower windows with smaller upper openings, restrained pilaster rhythm, and a continuous low roofline subordinate to the dome.",
            "modelResponse": "Lengthens the inward courtyard-facing facade to central-core width, keeping a calmer bay rhythm than the right wing while preserving two-story windows, plinth, cornice, and restrained pilasters."
          }
        },
        "camera": {
          "projection": "tile_oblique",
          "width": 1600,
          "height": 980,
          "scale": 40,
          "yScale": 1,
          "offsetX": 520,
          "offsetY": 140,
          "oblique": {
            "zDx": 0.5,
            "zDy": 0.866,
            "zScale": 0.82
          },
          "isometric": {
            "yawDeg": 0,
            "pitchDeg": 30
          },
          "rotationDeg": [
            0,
            0,
            0
          ]
        },
