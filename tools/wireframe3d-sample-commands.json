{
  "commands": [
    {
      "op": "create_scene",
      "overrides": {
        "meta": {
          "name": "campus-wireframe-sample",
          "units": "meters"
        },
        "camera": {
          "projection": "isometric",
          "width": 1200,
          "height": 900,
          "scale": 140
        },
        "style": {
          "background": "#050507",
          "stroke": "#f3f6ff",
          "strokeWidth": 1.25,
          "strokeOpacity": 0.92
        }
      }
    },
    {
      "op": "add_primitive",
      "id": "mass_core",
      "type": "cube",
      "params": {
        "size": 1.6
      },
      "transform": {
        "translate": [0, 0.8, 0],
        "rotateDeg": [0, 35, 0]
      }
    },
    {
      "op": "add_primitive",
      "id": "wing_a",
      "type": "rectangle",
      "params": {
        "width": 2.4,
        "height": 0.8,
        "depth": 1.1
      },
      "transform": {
        "translate": [1.7, 0.4, 0],
        "rotateDeg": [0, 20, 0]
      }
    },
    {
      "op": "add_primitive",
      "id": "wing_b",
      "type": "rectangle",
      "params": {
        "width": 2.2,
        "height": 0.8,
        "depth": 1.1
      },
      "transform": {
        "translate": [-1.7, 0.4, 0],
        "rotateDeg": [0, -20, 0]
      }
    },
    {
      "op": "add_primitive",
      "id": "connector",
      "type": "parallelogram",
      "params": {
        "width": 1.3,
        "height": 0.5,
        "depth": 1.0
      },
      "transform": {
        "translate": [0, 0.25, 0.9],
        "shear": {
          "xz": 0.25
        }
      }
    },
    {
      "op": "add_primitive",
      "id": "tower",
      "type": "cylinder",
      "params": {
        "radius": 0.45,
        "height": 2.2,
        "segments": 18
      },
      "transform": {
        "translate": [0, 1.1, -1.35]
      }
    },
    {
      "op": "add_primitive",
      "id": "dome_half",
      "type": "globe",
      "params": {
        "radius": 0.85,
        "latSegments": 10,
        "lonSegments": 16,
        "latStart": 0,
        "latEnd": 90,
        "lonStart": 0,
        "lonEnd": 360
      },
      "transform": {
        "translate": [0, 1.6, 0]
      }
    },
    {
      "op": "transform_primitive",
      "id": "wing_a",
      "rotateDeg": [0, 30, 5]
    },
    {
      "op": "update_primitive",
      "id": "tower",
      "style": {
        "stroke": "#9be7ff",
        "strokeWidth": 1.45,
        "strokeOpacity": 0.98
      }
    },
    {
      "op": "rotate_scene",
      "rotationDeg": [10, -15, 0]
    },
    {
      "op": "set_camera",
      "camera": {
        "isometric": {
          "yawDeg": 50,
          "pitchDeg": 32
        }
      }
    },
    {
      "op": "export_svg",
      "options": {
        "hiddenEdges": "far"
      }
    }
  ]
}

